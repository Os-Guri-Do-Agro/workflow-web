{
  "manifest_version": 3,
  "name": "Nevo — detector de atividade",
  "version": "1.0.0",
  "description": "Deixa o cronômetro do Nevo saber quando você está trabalhando fora do navegador, sem pedir permissão a cada acesso.",
  "permissions": [
    "idle",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://nevo.exemplo.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nevo.exemplo.com/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Nevo — detector de atividade",
    "default_popup": "popup.html"
  }
}
