VITE_API_URL="http://localhost:3535"

# Domínio onde o Nevo roda. Usado para empacotar a extensão (npm run
# extension:build), que só pode conversar com esta origem.
VITE_APP_ORIGIN="http://localhost:5173"

# Página da extensão na Chrome Web Store. Com ela preenchida, a tela /protecao
# instala em um clique; sem ela, o app oferece só a permissão do navegador (que
# dá a mesma proteção enquanto o Nevo estiver aberto).
VITE_EXTENSION_STORE_URL=""

# Tarefas recorrentes pela API (default: desligada).
#
# Desligada, as rotinas vivem em localStorage por empresa — o estado local que
# funciona sem backend. Ligada, elas passam a vir de
# GET /company/:id/activity-recurrence e do payload do board, e as escritas vão
# para a API.
#
# É variável de BUILD: mudar na Vercel não basta, é preciso um novo deploy.
# Exige o backend com `recurrences`, `monthNumber`, `from` e `to` no payload de
# GET /month/:monthId/board. Ver docs/specs/tarefas-recorrentes-frontend.md.
VITE_RECURRING_API_ENABLED="false"
